# Données locales de wrangler (KV, D1, R2 émulés) et dépendances
.wrangler/
node_modules/
# Secrets locaux : jamais dans le dépôt
.dev.vars
.dev.vars.*
# … sauf le modèle, qui ne contient aucun secret et dit quoi y mettre
!.dev.vars.exemple
.DS_Store
.apercu/
# Le lien d'accès d'une maquette (contient le secret ACCES_DEMO) : jamais dans le dépôt
.acces-demo
# Le dossier de travail de nouveau-client (« clients/.nouveau-<id>-XXXX »),
# renommé en clients/<id> à la fin, supprimé en cas d'erreur. Seul un
# arrêt brutal en laisse un : il ne doit pas bloquer un déploiement (dépôt
# « modifié ») ni partir dans un commit. deployer ne le prend pas pour un
# client : un identifiant ne commence jamais par un point.
clients/.nouveau-*/
